# Copy this file to `.env` and fill in real values.  NEVER commit `.env`.
# Where to find them: Supabase Dashboard -> Connect -> Server (or Settings -> API Keys)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Only needed to create the tables (scripts/apply_schema.py) -- one person, once.
# Supabase Dashboard -> Connect -> Session pooler -> copy the URI, then replace
# [YOUR-PASSWORD] with the database password (Project Settings -> Database).
# Use the SESSION POOLER string (works on IPv4 networks).
# If the password has special characters (@ : / # ?), URL-encode them.
DATABASE_URL=

# Optional
# SUPABASE_PUBLISHABLE_KEY=
